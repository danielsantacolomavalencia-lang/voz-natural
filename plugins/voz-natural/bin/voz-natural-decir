#!/bin/bash
# Voz natural (Mac): la voz de tu mano derecha, con la voz que ya trae tu Mac (orden `say`).
# Vive en `bin/` del plugin: mientras el plugin está encendido, Claude la corre como `voz-natural-decir` (y un solo
# permiso, `Bash(voz-natural-decir *)`, evita que pida permiso cada vez que habla).
#
#   voz-natural-decir 'frase'                      dice la frase y ESPERA a que termine (lo que oyes y lo que ves van juntos)
#   voz-natural-decir encender | apagar            el modo voz de la skill (para el recordatorio invisible de cada mensaje)
#   voz-natural-decir probar | voces               prueba la voz y muestra las voces en español de esta Mac
#   voz-natural-decir elegir 'Nombre de la voz'    usar otra voz
#   voz-natural-decir velocidad 200                palabras por minuto (150 a 230; 185 es lo normal)
#   voz-natural-decir recordatorio                 (gancho UserPromptSubmit) calla la voz anterior y, con el modo voz
#                                          encendido, le recuerda a Claude que siga hablando
#
# Solo usa lo que ya trae cualquier Mac: bash, say, awk, sed. No instala nada ni manda nada a internet.

set -u
# Siempre la misma carpeta (el gancho y la orden la comparten): tu voz y tu velocidad se quedan aquí para siempre.
DATA="${VOZ_DATOS:-$HOME/.claude/voz-natural}"
mkdir -p "$DATA" 2>/dev/null
CONF="$DATA/config"
PID="$DATA/habla.pid"

ESTADO="apagado"; VOZ=""; VELOCIDAD="185"
# shellcheck disable=SC1090
[ -f "$CONF" ] && . "$CONF"
guardar() { printf 'ESTADO=%q\nVOZ=%q\nVELOCIDAD=%q\n' "$ESTADO" "$VOZ" "$VELOCIDAD" > "$CONF"; }

# La mejor voz en español de esta Mac: Premium > Mejorada (Enhanced) > Paulina > Mónica > otra. Sin las voces «de
# juguete» (Eddy, Flo, Grandma…), que suenan robóticas.
mejor_voz() {
  say -v '?' 2>/dev/null | awk '
    { loc=""; for (i=1;i<=NF;i++) if ($i ~ /^[a-z][a-z]_[A-Z][A-Z]$/) { loc=$i; break } }
    loc !~ /^es_/ { next }
    { nombre=$0; sub(/[ ]+[a-z][a-z]_[A-Z][A-Z].*$/, "", nombre) }
    nombre ~ /^(Eddy|Flo|Grandma|Grandpa|Reed|Rocko|Sandy|Shelley)/ { next }
    { p=100
      if (nombre ~ /Premium/) p=400; else if (nombre ~ /(Enhanced|Mejorada|mejorada)/) p=300
      if (loc=="es_MX") p+=30; else if (loc=="es_US") p+=20; else if (loc=="es_ES") p+=10
      if (nombre ~ /^Paulina/) p+=5; else if (nombre ~ /^M[oó]nica/) p+=4
      print p "\t" nombre }' | sort -t$'\t' -k1,1nr | head -1 | cut -f2
}
# Las voces de Siri (las más naturales de la Mac) no se pueden pedir por nombre: `say` solo las usa cuando son la «voz
# del sistema» (Ajustes › Accesibilidad › Lectura y voz › Voz del sistema) y no se le dice qué voz usar. Aquí se mira
# si la voz del sistema para español es de Siri; devuelve su nombre («Carmen») o nada.
siri_del_sistema() {
  defaults read com.apple.Accessibility SpokenContentDefaultVoiceSelectionsByLanguage 2>/dev/null | awk '
    /boundLanguage *= *"?es/ { es=1 }
    /voiceId *= *"com\.apple\.siri\./ { id=$0 }
    /}/ { if (es && id != "") { sub(/.*com\.apple\.siri\.[a-z]*\.?/, "", id); sub(/[";].*/, "", id); print id; exit } es=0; id="" }'
}
SISTEMA="sistema"   # valor de VOZ: «la voz del sistema» (Siri)

# La voz que eligió el usuario se queda para siempre (archivo `config` en la carpeta de datos del plugin, que sobrevive a
# las actualizaciones). Si esa voz ya no está en la Mac (la borró), se usa la mejor que haya, sin perder su elección.
# Sin elección, gana Siri si es la voz del sistema; si no, la mejor de la lista.
voz_actual() {
  if [ "$VOZ" = "$SISTEMA" ] && [ -n "$(siri_del_sistema)" ]; then echo "$SISTEMA"
  elif [ -n "$VOZ" ] && [ "$VOZ" != "$SISTEMA" ] && say -v '?' 2>/dev/null | grep -qF "$VOZ "; then echo "$VOZ"
  elif [ -n "$(siri_del_sistema)" ]; then echo "$SISTEMA"
  else mejor_voz; fi
}
nombre_voz() { if [ "$1" = "$SISTEMA" ]; then echo "Siri ($(siri_del_sistema)), la voz del sistema"; else echo "${1:-la voz del sistema}"; fi; }
quien_eligio() {
  if [ -z "$VOZ" ]; then echo "elegida automáticamente: la mejor de tu Mac"
  elif [ "$(voz_actual)" = "$VOZ" ]; then echo "la que elegiste"
  elif [ "$VOZ" = "$SISTEMA" ]; then echo "elegiste Siri, pero la voz del sistema ya no es de Siri: uso la mejor que hay"
  else echo "tu voz elegida, $VOZ, ya no está en la Mac: uso la mejor que hay"; fi
}

callar() { if [ -f "$PID" ]; then local p; p="$(cat "$PID")"; rm -f "$PID"; kill "$p" 2>/dev/null; fi; }  # primero se borra la marca: así la orden sabe que la callaron a propósito

hablar() { # $1 = frase; espera a que termine
  local frase="$1" voz
  [ -z "$frase" ] && return 0
  voz="$(voz_actual)"
  echo "$(date '+%Y-%m-%d %H:%M:%S') · ${#frase} letras · $(nombre_voz "$voz")" >> "$DATA/voz.log" 2>/dev/null
  callar
  if [ -n "$voz" ] && [ "$voz" != "$SISTEMA" ]; then say -v "$voz" -r "$VELOCIDAD" "$frase" & else say -r "$VELOCIDAD" "$frase" & fi
  local pid=$!
  echo "$pid" > "$PID"
  # Esc en Claude Code corta esta orden: la voz se calla con ella (sin esto, `say` seguiría hablando sola).
  trap 'kill "$pid" 2>/dev/null; rm -f "$PID"; exit 130' INT TERM HUP
  # Y si la cortan de golpe (sin dejarla limpiar), un vigía calla la voz en cuanto esta orden desaparece.
  ( yo=$$; while kill -0 "$yo" 2>/dev/null && kill -0 "$pid" 2>/dev/null; do sleep 0.2; done; kill "$pid" 2>/dev/null ) &
  if wait "$pid"; then trap - INT TERM HUP; rm -f "$PID"; return 0; fi
  trap - INT TERM HUP
  if [ ! -f "$PID" ]; then echo "(callada: el usuario siguió hablando)"; return 0; fi   # la calló un mensaje nuevo
  rm -f "$PID"
  echo "SIN VOZ: la Mac no pudo decir la frase (revisa el volumen o prueba con /voz-natural:probar)." >&2
  return 1
}

RECORDATORIO="[Modo voz encendido] Sigue la skill voz-natural:modo-voz en esta respuesta: tu respuesta escrita queda igual que siempre y, justo antes de tu mensaje final, le cuentas en voz el resumen con voz-natural-decir 'frase', como un colega (qué hiciste y dónde quedó, lo importante sin omitir, y lo que necesitas de él). Si te pide apagarlo, apágalo con voz-natural-decir apagar."

case "${1:-}" in
  recordatorio)
    cat > /dev/null
    callar                                        # si le estabas hablando, se calla: ya te está respondiendo
    [ "$ESTADO" = "encendido" ] && echo "$RECORDATORIO"
    exit 0 ;;
  encender) ESTADO="encendido"; guardar; echo "Modo voz encendido. Voz: $(nombre_voz "$(voz_actual)") ($(quien_eligio)) · velocidad: $(awk -v v="$VELOCIDAD" 'BEGIN { printf "%.2fx", v/185 }')" ;;
  apagar)   ESTADO="apagado"; guardar; callar; echo "Modo voz apagado. Lo escrito sigue igual." ;;
  probar)
    v="$(voz_actual)"
    echo "Voz: $(nombre_voz "$v") ($(quien_eligio)) · velocidad: $(awk -v v="$VELOCIDAD" 'BEGIN { printf "%.2fx", v/185 }') · modo voz: $ESTADO"
    hablar "Hola, soy tu mano derecha. Así te voy a contar lo que hago, para que casi no tengas que leer." ;;
  voces)
    echo "Voces en español de esta Mac:"
    say -v '?' | awk '{ for (i=1;i<=NF;i++) if ($i ~ /^es_/) { print; break } }' | grep -vE '^(Eddy|Flo|Grandma|Grandpa|Reed|Rocko|Sandy|Shelley) '
    s="$(siri_del_sistema)"
    if [ -n "$s" ]; then echo "Siri: «$s» es la voz del sistema (la más natural). Se pide con «usa la voz de Siri»."
    else echo "Siri: no es la voz del sistema. Para usarla: Ajustes › Accesibilidad › Lectura y voz › Voz del sistema › Siri."; fi
    echo "Elegida: $(nombre_voz "$(voz_actual)")" ;;
  elegir)
    # Acepta el nombre a medias («mónica», «paulina mejorada»): se queda con la mejor voz en español que lo contenga.
    # «automática» (o nada) vuelve a dejar que el plugin elija la mejor.
    pedido="${2:-}"
    case "$(printf '%s' "$pedido" | tr '[:upper:]' '[:lower:]')" in ""|auto|automatica|automática) VOZ="" ;;
      siri|*siri*|"voz del sistema"|sistema)
        if [ -z "$(siri_del_sistema)" ]; then
          echo "La voz de Siri todavía no es la voz del sistema. Ajustes del Sistema › Accesibilidad › Lectura y voz › Voz del sistema › elige una de Siri (descárgala si hace falta) y vuelve a pedírmelo."; exit 1
        fi
        VOZ="$SISTEMA" ;;
      *)
        VOZ="$(say -v '?' | awk '{ for (i=1;i<=NF;i++) if ($i ~ /^es_/) { loc=$i; n=$0; sub(/[ ]+[a-z][a-z]_[A-Z][A-Z].*$/, "", n); print loc "\t" n; break } }' |
          awk -F'\t' -v q="$pedido" 'function plano(t) { t=tolower(t); gsub(/[()]/, "", t)
              gsub(/á|Á/, "a", t); gsub(/é|É/, "e", t); gsub(/í|Í/, "i", t); gsub(/ó|Ó/, "o", t); gsub(/ú|Ú|ü/, "u", t)
              gsub(/ñ|Ñ/, "n", t); return t }
            BEGIN { q=plano(q); nq=split(q, w, / +/) }
            { n=plano($2); ok=1; for (i=1;i<=nq;i++) if (index(n, w[i])==0) ok=0
              if (!ok) next
              p=100; if (n ~ /premium/) p=400; else if (n ~ /mejorada|enhanced/) p=300
              if ($1=="es_MX") p+=30; else if ($1=="es_US") p+=20; else if ($1=="es_ES") p+=10
              print p "\t" $2 }' | sort -t$'\t' -k1,1nr | head -1 | cut -f2)"
        if [ -z "$VOZ" ]; then echo "No encontré una voz en español que se llame «$pedido». Estas son las que hay:"; "$0" voces; exit 1; fi ;;
    esac
    guardar; echo "Voz: $(nombre_voz "$(voz_actual)")"; hablar "Esta es mi nueva voz." ;;
  velocidad)
    # Palabras por minuto (185 = normal) o un multiplicador como en otros lectores: «1.2x», «1,2», «x1.5».
    v="$(printf '%s' "${2:-185}" | tr ',' '.' | tr -d 'xX ')"
    VELOCIDAD="$(awk -v v="$v" 'BEGIN { if (v+0 <= 0) v=185; else if (v+0 < 5) v=v*185; v=int(v+0.5); if (v<120) v=120; if (v>300) v=300; print v }')"
    guardar; echo "Velocidad: $VELOCIDAD palabras por minuto ($(awk -v v="$VELOCIDAD" 'BEGIN { printf "%.2fx", v/185 }'))"
    hablar "Así sueno a esta velocidad." ;;
  "")        echo "Uso: voz-natural-decir 'frase' | encender | apagar | probar | voces | elegir 'voz' | velocidad 185" >&2; exit 1 ;;
  *)         hablar "$*" ;;
esac
